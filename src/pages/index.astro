---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Aswin's Portfolio">
    <main>
        <div class="profile">
            <img
                src="/profile-photo.png"
                alt="[YOUR NAME]"
                class="profile-pic"
            />
            <h1>Hi, I'm Aswin Pradeep!</h1>
            <p>
                Integrated BS-MS program at IISER Mohali, majoring in Biological
                Sciences with a minor in Data Science. My principal research
                interests lie in understanding how agents make decisions based
                on their internal models of the environment—a pursuit driven by
                my lifelong ambition to unravel the functions of consciousness.
            </p>
            <p>Please feel free to get in touch!</p>
            <div class="social-links">
                <a
                    href="mailto:[ms22276@iisermohali.ac.in]"
                    aria-label="Email"
                    title="Email"
                >
                    <Icon name="email" />
                </a>
                <a
                    href="[https://github.com/Aswin-neuro?tab=repositories]"
                    aria-label="GitHub"
                    title="GitHub"
                >
                    <Icon name="github" />
                </a>
                <a
                    href="[YOUR LINKEDIN URL]"
                    aria-label="LinkedIn"
                    title="LinkedIn"
                >
                    <Icon name="linkedin" />
                </a>
            </div>
        </div>
    </main>
    <style>
        main {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 80vh;
            text-align: center;
            padding: 0 20px;
        }
        .profile {
            max-width: 600px;
            margin-top: -10vh; /* Pull the profile up a bit */
        }
        .profile-pic {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 20px;
        }
        h1 {
            font-size: 2.5rem;
            margin: 15px 0 0.9em 0;
            line-height: 1em;
        }
        p {
            font-size: 1.1rem;
        }
        .social-links {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 21px;
        }
        .social-links a {
            color: var(--text-color);
            transition: color 0.2s;
        }
        .social-links a:hover {
            color: var(--nav-link-hover-color);
        }
        .social-links .icon-wrapper {
            width: 24px;
            height: 24px;
        }
    </style>
</BaseLayout>
